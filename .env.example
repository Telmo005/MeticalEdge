# MeticalEdge — variáveis de ambiente

## Supabase (projecto reaproveitado — ver README.md para os passos de setup)
# Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Dashboard -> Project Settings -> API -> anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dashboard -> Project Settings -> Database -> Connection string
# USAR O TRANSACTION POOLER (porta 6543), não o session pooler (5432) — ver
# comentário em db/index.ts.
DATABASE_URL=

## Cron (protege /api/cron/scan — gerar um valor aleatório longo, ex.:
## `openssl rand -hex 32`)
CRON_SECRET=

## Gateway de mensagens partilhado (o mesmo "payment gateway" que o Duelo
## usa) — para os alertas push. MESSAGING_API_KEY é uma cópia do
## CRON_SECRET desse projecto (não é uma chave por-app, ver
## payment gateway/docs/ENDPOINTS.md secção 2).
MESSAGING_BASE_URL=
MESSAGING_API_KEY=

## URL pública desta app (usada em nenhum sítio crítico ainda, mas
## consistente com o padrão dos outros apps)
NEXT_PUBLIC_APP_URL=
